# Server-only MQTT Gateway HTTP command endpoint and credential.
MQTT_GATEWAY_URL=http://127.0.0.1:8000
MQTT_GATEWAY_API_KEY=

# Server-only: ký access token của app người nhà (/api/app/v1). Chuỗi ngẫu nhiên >= 32 ký tự,
# ví dụ: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
APP_JWT_SECRET=

# Server-only: kết nối database cho Next.js. Dùng Supabase "Transaction pooler" (cổng 6543), lấy ở
# Supabase Dashboard -> Connect -> Transaction pooler. DIRECT_DATABASE_URL (Session pooler, cổng 5432)
# chỉ dùng cho drizzle-kit migrate.
DATABASE_URL=
DIRECT_DATABASE_URL=
